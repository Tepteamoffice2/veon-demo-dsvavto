---
// A future page that is not built in the demo yet (menu item, button, chip, footer link).
// Inactive element with a short note instead of a link: never points to the client's current site.
import { NOTE } from "../data/site";
interface Props { note?: string; class?: string; rec?: string; }
const { note = NOTE, class: cls, rec } = Astro.props;
---
<span class:list={["future-link", cls]} role="link" aria-disabled="true" tabindex="0" data-rec={rec} data-future>
  <slot />
  <span class="future-link__note" aria-hidden="true">{note}</span>
  <span class="visually-hidden">({note})</span>
</span>
