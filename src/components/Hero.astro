---
import FutureLink from "./FutureLink.astro";
import { phones, telegram, makes } from "../data/site";

// Sample VIN (structure per ISO 3779), clearly labelled as an example.
const vinGroups = [
  { range: "1–3", label: "виробник", chars: "WVW" },
  { range: "4–9", label: "модель, кузов, двигун", chars: "ZZZ1KZ" },
  { range: "10–17", label: "рік, завод, номер", chars: "6W123456" },
];
---
<section id="hero" class="hero" data-rec="W-R001,W-R008,G-R005">
  <div class="container hero__head">
    <h1 class="hero__title">Автозапчастини в Києві, підібрані <span class="hero__nowrap">за VIN-кодом</span></h1>
    <p class="hero__lede">Для іномарок і вітчизняних авто. Підбір безкоштовний, доставка Новою Поштою по Україні.</p>
  </div>

  <div class="container">
    <div class="finder on-accent" data-tabs data-rec="W-R001,W-R002,W-R003,G-R002,M-R003">
      <div class="finder__head">
        <h2 class="finder__title" id="finder-title">Підбір запчастини</h2>
        <div class="finder__tabs" role="tablist" aria-labelledby="finder-title">
          <button type="button" role="tab" id="tab-vin" aria-controls="panel-vin" aria-selected="true" class="finder__tab">VIN-код</button>
          <button type="button" role="tab" id="tab-art" aria-controls="panel-art" aria-selected="false" tabindex="-1" class="finder__tab">Артикул</button>
          <button type="button" role="tab" id="tab-make" aria-controls="panel-make" aria-selected="false" tabindex="-1" class="finder__tab">Марка й модель</button>
          <span class="finder__mark" aria-hidden="true" data-tab-mark></span>
        </div>
      </div>

      <div role="tabpanel" id="panel-vin" aria-labelledby="tab-vin" class="finder__panel finder__panel--vin is-active" tabindex="0">
        <h3 class="finder__panel-title">VIN-код</h3>
        <figure class="vin" aria-labelledby="vin-cap">
          <div class="vin__groups">
            {vinGroups.map((g, gi) => (
              <div class="vin__group" style={`--n:${g.chars.length}; --g:${gi}`}>
                <p class="vin__dim">
                  <span class="vin__line" aria-hidden="true"></span>
                  <span class="vin__label"><span class="vin__range figure">{g.range}</span> {g.label}</span>
                </p>
                <ol class="vin__cells" aria-label={`Символи ${g.range}`}>
                  {g.chars.split("").map((c) => <li class="vin__cell">{c}</li>)}
                </ol>
              </div>
            ))}
          </div>
          <figcaption id="vin-cap" class="vin__cap">Приклад VIN: 17 символів, є у вашому техпаспорті.</figcaption>
        </figure>

        <div class="finder__act">
          <p class="finder__text">Надішліть VIN або фото техпаспорта: менеджер підбере оригінал і аналоги, ціни й строки скаже в чаті.</p>
          <div class="finder__btns">
            <a class="btn btn--inverse finder__main" href={telegram.href} target="_blank" rel="noopener" data-rec="W-R001,W-R003,W-R005">
              Надіслати VIN у Telegram<span class="visually-hidden"> (відкриється в Telegram)</span>
            </a>
            <a class="btn btn--quiet" href={phones.main.href} data-rec="W-R005">
              Подзвонити <span class="btn__sub">{phones.main.label}</span>
            </a>
          </div>
          <p class="finder__small">Дзвінок безкоштовний по Україні. Або напишіть: <a class="link" href="mailto:support@dsvavto.ua">support@dsvavto.ua</a></p>
        </div>
      </div>

      <div role="tabpanel" id="panel-art" aria-labelledby="tab-art" class="finder__panel finder__panel--art" tabindex="0">
        <h3 class="finder__panel-title">Артикул</h3>
        <div class="finder__search">
          <label class="finder__label" for="part-q">Артикул або назва деталі</label>
          <div class="finder__field">
            <input id="part-q" name="q" type="text" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-describedby="part-hint" class="finder__input" data-search-input />
            <FutureLink class="btn btn--inverse finder__find" note="Пошук запрацює в повній версії сайту">Знайти</FutureLink>
          </div>
          <p class="finder__hint" id="part-hint">
            Поки що назвіть артикул менеджеру: <a class="link figure-link" href={phones.main.href}>{phones.main.label}</a> або <a class="link" href={telegram.href} target="_blank" rel="noopener">Telegram<span class="visually-hidden"> (відкриється в Telegram)</span></a>.
          </p>
        </div>
      </div>

      <div role="tabpanel" id="panel-make" aria-labelledby="tab-make" class="finder__panel finder__panel--make" tabindex="0" data-rec="W-R002">
        <h3 class="finder__panel-title">Марка й модель</h3>
        <ul class="chips" aria-label="Марки авто">
          {makes.map((m) => <li><FutureLink class="chip">{m}</FutureLink></li>)}
          <li><FutureLink class="chip chip--all">Усі марки</FutureLink></li>
        </ul>
        <p class="finder__hint">
          Підбір за авто з'явиться в повній версії сайту. Зараз швидше за VIN:
          <button type="button" class="finder__goto" data-goto-tab="tab-vin">перейти до VIN-коду</button>
        </p>
      </div>
    </div>

    <ul class="facts" aria-label="Коротко">
      <li class="facts__item"><a class="facts__key figure" href={phones.main.href}>{phones.main.label}</a><span class="facts__val">безкоштовна лінія по Україні</span></li>
      <li class="facts__item"><span class="facts__key figure">Нова Пошта</span><span class="facts__val">доставка по всій Україні</span></li>
      <li class="facts__item"><a class="facts__key figure" href="#sto">СТО на Бандери, 30</a><span class="facts__val">встановимо куплене у нас</span></li>
    </ul>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.5rem, 0.8rem + 2vw, 2.5rem) var(--space-md); }
  .hero__head { display: grid; gap: var(--space-md); margin-bottom: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .hero__title { max-width: 24ch; }
  .hero__nowrap { white-space: nowrap; }
  .hero__lede { font-size: var(--text-lede); line-height: 1.45; color: var(--color-text-2); max-width: 66ch; }

  /* The working strip: the logo's green plate with its slanted left edge */
  .finder {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg);
    padding: var(--space-md) var(--space-md) var(--space-lg) calc(var(--space-md) + var(--chamfer-l) * 0.5);
    background: var(--color-field); color: var(--color-on-accent);
    clip-path: polygon(var(--chamfer-l) 0, 100% 0, 100% 100%, 0 100%);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .finder__head { display: grid; gap: var(--space-sm); }
  .finder__title { font-size: var(--text-title); line-height: 1.1; color: var(--color-on-accent); }
  .finder__tabs { position: relative; display: flex; gap: var(--space-2xs); flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; border-bottom: var(--hairline) solid var(--color-rule-accent); }
  .finder__tab {
    min-height: var(--tap);
    padding: 0 var(--space-sm);
    background: transparent; border: 0; border-radius: var(--radius) var(--radius) 0 0;
    color: var(--color-on-accent-2);
    font-weight: var(--weight-bold); font-size: var(--text-body); white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }
  .finder__tab:hover { color: var(--color-on-accent); background: color-mix(in oklab, var(--color-bg) 8%, var(--color-accent)); }
  .finder__tab[aria-selected="true"] { color: var(--color-on-accent); }
  .finder__tab:focus-visible { outline-offset: -2px; }
  .finder__mark {
    position: absolute; left: 0; bottom: -2px; width: 100px; height: 4px;
    background: var(--color-on-accent);
    clip-path: polygon(0 0, 100% 0, calc(100% - 3px) 100%, 3px 100%);
    transform-origin: left center;
    transform: translateX(var(--mark-x, 0px)) scaleX(var(--mark-s, 0));
    transition: transform var(--dur-tab) var(--ease-out);
  }
  :global(html:not(.js)) .finder__tabs { display: none; }
  .finder__panel-title { font-size: var(--text-title); color: var(--color-on-accent); }
  :global(.js) .finder__panel-title { display: none; }
  :global(html:not(.js)) .finder__panel + .finder__panel { border-top: var(--hairline) solid var(--color-rule-accent); padding-top: var(--space-lg); }
  :global(.js) .finder__panel:not(.is-active) { display: none; }
  :global(.js) .finder__panel.is-active { animation: panel-in var(--dur-tab) var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; } to { opacity: 1; } }
  .finder__panel:focus-visible { outline-offset: 4px; }

  /* VIN panel */
  .finder__panel--vin { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
  .vin { margin: 0; container-type: inline-size; }
  .vin__groups { display: grid; gap: var(--space-md); }
  .vin__group { display: grid; gap: var(--space-xs); }
  .vin__dim { position: relative; display: grid; gap: var(--space-2xs); }
  .vin__line {
    position: relative; display: block; height: 9px;
    border-bottom: var(--hairline) solid var(--color-on-accent);
    transform-origin: center;
  }
  .vin__line::before, .vin__line::after { content: ""; position: absolute; bottom: -5px; width: 1px; height: 10px; background: var(--color-on-accent); }
  .vin__line::before { left: 0; }
  .vin__line::after { right: 0; }
  .vin__dim { grid-template-rows: auto auto; }
  .vin__label { order: -1; font-size: var(--text-small); line-height: 1.3; color: var(--color-on-accent-2); }
  .vin__range { color: var(--color-on-accent); margin-right: var(--space-2xs); }
  .vin__cells { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: var(--space-2xs); }
  .vin__cell {
    display: grid; place-items: center;
    aspect-ratio: 5 / 6;
    border: var(--hairline) solid var(--color-rule-accent);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--color-dark) 22%, var(--color-accent));
    font-family: var(--font-display); font-weight: var(--weight-bold);
    font-size: clamp(1.25rem, 7.4cqi, var(--text-vin)); line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .vin__group .vin__dim { max-width: calc(var(--n) / 8 * 100%); }
  .vin__cap { margin-top: var(--space-sm); font-size: var(--text-small); color: var(--color-on-accent-2); }

  .finder__act { display: grid; gap: var(--space-md); align-content: start; }
  .finder__text { max-width: 44ch; }
  .finder__btns { display: grid; gap: var(--space-sm); }
  .finder__btns .btn { width: 100%; }
  .finder__small { font-size: var(--text-small); color: var(--color-on-accent-2); }

  /* Article panel */
  .finder__search { display: grid; gap: var(--space-xs); max-width: 46rem; }
  .finder__label { font-weight: var(--weight-bold); }
  .finder__field { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
  .finder__input {
    min-height: var(--control-h); width: 100%;
    padding: 0 var(--space-md);
    background: var(--color-panel); color: var(--color-text);
    border: var(--stroke-ui) solid var(--color-line-ui); border-radius: var(--radius);
    font: var(--weight-regular) 1rem/1.2 var(--font-body);
    font-size: max(16px, var(--text-body));
    caret-color: var(--color-accent);
  }
  .finder__input:focus-visible { outline: 2px solid var(--color-focus-inverse); outline-offset: 2px; }
  .finder__input:hover { border-color: var(--color-text); }
  .finder__find { text-decoration: none; }
  .finder__find :global(.future-link__note) { left: auto; right: 0; }
  .finder__hint { min-height: 1lh; color: var(--color-on-accent-2); }
  .finder__hint .link, .finder__small .link { color: var(--color-on-accent); }

  /* Make panel */
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-md); }
  .chips :global(.chip) {
    min-height: var(--tap); padding: 0 var(--space-md);
    border: var(--hairline) solid var(--color-rule-accent); border-radius: var(--radius);
    text-decoration: none; font-weight: var(--weight-bold); white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out);
  }
  .chips :global(.chip:hover), .chips :global(.chip:focus-visible) { border-color: var(--color-on-accent); background: color-mix(in oklab, var(--color-bg) 8%, var(--color-accent)); }
  .chips :global(.chip--all) { border-style: dashed; }
  .finder__goto {
    display: inline; padding: 0; min-height: var(--tap);
    background: none; border: 0;
    color: var(--color-on-accent); font-weight: var(--weight-bold);
    text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer;
  }
  .finder__goto:hover { text-decoration-thickness: 2px; }

  /* Facts row */
  .facts { display: grid; gap: var(--space-md); margin-top: var(--space-md); }
  .facts__item { display: grid; gap: var(--space-3xs); padding-top: var(--space-sm); border-top: var(--hairline) solid var(--color-rule); }
  .facts__key { font-size: 1.25rem; line-height: 1.2; text-decoration: none; color: var(--color-text); }
  a.facts__key:hover { color: var(--color-accent); }
  .facts__val { color: var(--color-text-2); font-size: var(--text-small); }

  @media (max-width: 47.99rem) {
    .finder__title { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .finder { margin-right: calc(var(--gutter) * -1); padding-right: var(--gutter); border-radius: 0; }
    .finder__tab { flex: 1 0 auto; padding: 0 var(--space-xs); font-size: 0.9375rem; }
    .finder__act { display: contents; }
    .finder__text { order: 3; }
    .finder__btns { order: 2; }
    .finder__small { order: 4; }
    .finder__panel--vin { gap: var(--space-md); }
    .vin__cap { margin-top: var(--space-xs); }
  }

  @media (min-width: 48rem) {
    .finder { padding: var(--space-lg) var(--space-xl) var(--space-xl) calc(var(--space-xl) + var(--chamfer-l) * 0.5); }
    .finder__head { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: var(--space-xl); }
    .finder__title { padding-bottom: var(--space-sm); }
    .finder__field { grid-template-columns: minmax(0, 1fr) auto; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); }
    .finder__btns { grid-template-columns: repeat(2, max-content); }
    .finder__btns .btn { width: auto; }
  }

  @media (min-width: 64rem) {
    .finder__panel--vin { grid-template-columns: minmax(0, 1fr) minmax(19rem, 22rem); grid-template-areas: "vin btns" "text small"; gap: var(--space-md) var(--space-2xl); align-items: start; }
    .finder__act { display: contents; }
    .vin { grid-area: vin; }
    .finder__btns { grid-area: btns; }
    .finder__text { grid-area: text; max-width: 62ch; }
    .finder__small { grid-area: small; }
    .vin__groups { grid-template-columns: 3fr 6fr 8fr; gap: var(--space-md); }
    .vin__cells { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .vin__group .vin__dim { max-width: none; }
    .vin__cell { font-size: clamp(1.25rem, 4.2cqi, var(--text-vin)); aspect-ratio: 3 / 4; }
    .finder__btns { grid-template-columns: minmax(0, 1fr); }
    .finder__btns .btn { width: 100%; }
  }

  /* Motion 1: the VIN dimension lines are drawn from the centre of each segment, then the labels appear. */
  @media (prefers-reduced-motion: no-preference) {
    .vin__line { animation: dim-draw var(--dur-draw) var(--ease-out) calc(150ms + var(--g) * 90ms) both; }
    .vin__label { animation: dim-label 300ms var(--ease-out) calc(550ms + var(--g) * 90ms) both; }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 47.99rem) {
    .vin__line { animation: none; }
    .vin__label { animation: dim-label 300ms var(--ease-out) 150ms both; }
  }
  @keyframes dim-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes dim-label { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .finder__mark { transition: none; }
    :global(.js) .finder__panel.is-active { animation: none; }
  }
</style>

<script>
  // Tabs: real switching (ARIA tabs, arrow keys), sliding mark under the active tab, «Знайти» note on Enter.
  const root = document.querySelector<HTMLElement>("[data-tabs]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const mark = root.querySelector<HTMLElement>("[data-tab-mark]");
    const list = root.querySelector<HTMLElement>('[role="tablist"]');

    const place = (tab: HTMLElement) => {
      if (!mark || !list) return;
      const l = list.getBoundingClientRect();
      const r = tab.getBoundingClientRect();
      mark.style.setProperty("--mark-x", `${r.left - l.left}px`);
      mark.style.setProperty("--mark-s", `${r.width / 100}`);
    };

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") || "");
        panel?.classList.toggle("is-active", on);
      }
      place(tab);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        let next = -1;
        if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next >= 0) { e.preventDefault(); select(tabs[next], true); }
      });
    });

    root.querySelectorAll<HTMLButtonElement>("[data-goto-tab]").forEach((b) => {
      b.addEventListener("click", () => {
        const t = document.getElementById(b.dataset.gotoTab || "") as HTMLButtonElement | null;
        if (t) select(t, true);
      });
    });

    const current = tabs.find((t) => t.getAttribute("aria-selected") === "true") || tabs[0];
    requestAnimationFrame(() => place(current));
    document.fonts?.ready.then(() => place(tabs.find((t) => t.getAttribute("aria-selected") === "true") || current));
    window.addEventListener("resize", () => place(tabs.find((t) => t.getAttribute("aria-selected") === "true") || current), { passive: true });

    // Enter in the article field does not send anything: it shows the note of the inactive «Знайти».
    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const find = root.querySelector<HTMLElement>(".finder__find");
    input?.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" || !find) return;
      e.preventDefault();
      find.classList.add("is-open");
      window.setTimeout(() => find.classList.remove("is-open"), 3000);
    });
  }
</script>
