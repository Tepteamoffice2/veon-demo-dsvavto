---
import FutureLink from "./FutureLink.astro";
import { nav, phones, telegram } from "../data/site";
---
<header class="site-header" data-rec="W-R003,W-R004,W-R005">
  <div class="container site-header__row">
    <a class="site-header__logo" href="#top" aria-label="DsvAvto, на початок сторінки">
      <img src="logo-dsvavto.svg" alt="DsvAvto" width="349" height="102" />
    </a>

    <nav class="site-nav" aria-label="Розділи сторінки" data-rec="W-R003,W-R007">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li><a class="site-nav__link" href={item.href} data-spy>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={phones.main.href} data-rec="W-R005">
        <span class="site-header__phone-num figure">{phones.main.label}</span>
        <span class="site-header__phone-note">{phones.main.note}</span>
      </a>
      <a class="site-header__tg" href={telegram.href} target="_blank" rel="noopener" data-rec="W-R005">
        Telegram<span class="visually-hidden"> (відкриється в Telegram)</span>
      </a>
      <div class="site-header__lang" data-rec="W-R004">
        <span class="site-header__lang-current" aria-current="true" lang="uk">UA</span>
        <FutureLink note="Російська версія — у повній версії сайту"><span lang="ru">RU</span></FutureLink>
      </div>

      <a class="site-header__call" href={phones.main.href} data-rec="W-R005">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
        <span class="visually-hidden">Подзвонити безкоштовно: 0 800 33-97-97</span>
      </a>

      <details class="menu" data-menu>
        <summary class="menu__toggle">Меню</summary>
        <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Меню">
          <div class="container menu__inner">
            <div class="menu__top">
              <img src="logo-dsvavto.svg" alt="" width="349" height="102" class="menu__logo" />
              <button type="button" class="menu__close" data-menu-close>Закрити</button>
            </div>
            <ul class="menu__list">
              {nav.map((item) => (
                <li><a class="menu__link" href={item.href} data-menu-link>{item.label}</a></li>
              ))}
            </ul>
            <div class="menu__contacts">
              <a class="menu__phone figure" href={phones.main.href}>{phones.main.label}</a>
              <p class="menu__note">{phones.main.note}</p>
              <p class="menu__sto">Запис на СТО: {phones.sto.map((p, i) => (<>{i > 0 && ", "}<a class="link tnum" href={p.href}>{p.label}</a></>))}</p>
              <a class="btn menu__tg" href={telegram.href} target="_blank" rel="noopener">Написати в Telegram<span class="visually-hidden"> (відкриється в Telegram)</span></a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: var(--hairline) solid var(--color-rule);
  }
  .site-header__row {
    display: flex; align-items: center; gap: var(--space-lg);
    min-height: var(--header-h);
  }
  .site-header__logo { flex-shrink: 0; display: block; }
  .site-header__logo img { height: 40px; width: auto; }

  .site-nav { display: none; }
  .site-nav__list { display: flex; gap: var(--space-lg); }
  .site-nav__link {
    position: relative; display: inline-flex; align-items: center;
    min-height: var(--header-h);
    font-size: var(--text-small); font-weight: var(--weight-bold);
    text-decoration: none; white-space: nowrap; color: var(--color-text);
    transition: color var(--dur-short) var(--ease-out);
  }
  .site-nav__link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 6px;
    border-top: 2px solid var(--color-accent);
    background: repeating-linear-gradient(90deg, var(--color-accent) 0 1px, transparent 1px 6px);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-short) var(--ease-out);
  }
  .site-nav__link:hover { color: var(--color-accent); }
  .site-nav__link[aria-current="true"] { color: var(--color-accent); }
  .site-nav__link[aria-current="true"]::after { transform: none; }

  .site-header__actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-md); }
  .site-header__phone {
    display: none; text-decoration: none; line-height: 1.1;
    flex-direction: column; align-items: flex-end;
  }
  .site-header__phone-num { font-size: 1.375rem; white-space: nowrap; transition: color var(--dur-short) var(--ease-out); }
  .site-header__phone:hover .site-header__phone-num { color: var(--color-accent); }
  .site-header__phone-note { font-size: var(--text-small); color: var(--color-text-2); white-space: nowrap; }
  .site-header__tg {
    display: none; align-items: center; min-height: var(--tap);
    padding: 0 var(--space-md);
    border: var(--stroke-ui) solid var(--color-text); border-radius: var(--radius);
    font-weight: var(--weight-bold); font-size: var(--text-small); text-decoration: none; white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .site-header__tg:hover { background: var(--color-panel); }
  .site-header__lang { display: none; align-items: center; gap: var(--space-xs); font-size: var(--text-small); }
  .site-header__lang-current { font-weight: var(--weight-bold); }
  .site-header__lang :global(.future-link__note) { left: auto; right: 0; }

  .site-header__call {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap); height: var(--tap);
    background: var(--color-accent); color: var(--color-on-accent);
    border-radius: var(--radius);
    transition: transform var(--dur-micro) var(--ease-out);
  }
  .site-header__call:active { transform: translateY(1px); }

  .menu__toggle {
    display: inline-flex; align-items: center; min-height: var(--tap);
    padding: 0 var(--space-md);
    border: var(--stroke-ui) solid var(--color-text); border-radius: var(--radius);
    font-weight: var(--weight-bold); font-size: var(--text-body);
    cursor: pointer; list-style: none; user-select: none;
  }
  .menu__toggle::-webkit-details-marker { display: none; }
  .menu__toggle:hover { background: var(--color-panel); }
  .menu__panel {
    position: fixed; inset: 0; z-index: var(--z-menu);
    background: var(--color-bg);
    overflow-y: auto;
  }
  .menu[open] .menu__panel { animation: menu-in var(--dur-short) var(--ease-out); }
  @keyframes menu-in { from { opacity: 0; } to { opacity: 1; } }
  .menu__inner { display: grid; gap: var(--space-xl); padding-bottom: var(--space-2xl); }
  .menu__top { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); border-bottom: var(--hairline) solid var(--color-rule); }
  .menu__logo { height: 34px; width: auto; }
  .menu__close {
    min-height: var(--tap); padding: 0 var(--space-md);
    background: transparent; border: var(--stroke-ui) solid var(--color-text); border-radius: var(--radius);
    font-weight: var(--weight-bold); cursor: pointer;
  }
  .menu__close:hover { background: var(--color-panel); }
  .menu__list { display: grid; }
  .menu__link {
    display: flex; align-items: center; min-height: 56px;
    border-bottom: var(--hairline) solid var(--color-rule);
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-title);
    text-decoration: none;
  }
  .menu__link:hover { color: var(--color-accent); }
  .menu__contacts { display: grid; gap: var(--space-xs); justify-items: start; }
  .menu__phone { font-size: var(--text-section); text-decoration: none; white-space: nowrap; }
  .menu__sto a { white-space: nowrap; }
  .menu__note, .menu__sto { color: var(--color-text-2); }
  .menu__tg { margin-top: var(--space-md); }

  @media (max-width: 47.99rem) {
    .site-header__logo img { height: 34px; }
    .site-header__actions { gap: var(--space-xs); }
  }
  @media (min-width: 48rem) {
    .site-header__call { display: none; }
    .site-header__phone, .site-header__tg { display: flex; }
  }
  @media (min-width: 75rem) {
    .site-nav { display: block; margin-left: var(--space-md); }
    .site-header__tg, .site-header__lang { display: inline-flex; }
    .menu { display: none; }
    .site-header__actions { gap: var(--space-lg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav__link::after { transition: none; }
  }
</style>
