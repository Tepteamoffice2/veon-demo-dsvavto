---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Catalog from "../components/Catalog.astro";
import Sto from "../components/Sto.astro";
import Terms from "../components/Terms.astro";
import Stores from "../components/Stores.astro";
import Footer from "../components/Footer.astro";
import Callbar from "../components/Callbar.astro";
import { socials } from "../data/site";

const title = "Автозапчастини в Києві з підбором за VIN | DsvAvto";
const description = "Автозапчастини для іномарок і вітчизняних авто: безкоштовний підбір за VIN у Telegram, власне СТО на Бандери, 30, доставка Новою Поштою по Україні.";

const addr = (street: string) => ({ "@type": "PostalAddress", streetAddress: street, addressLocality: "Київ", addressCountry: "UA" });
const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "#org",
      name: "DsvAvto",
      telephone: "+380800339797",
      email: "info@dsvavto.ua",
      sameAs: socials.map((s) => s.href),
    },
    {
      "@type": "AutoPartsStore",
      name: "DsvAvto, пр. Степана Бандери, 30",
      parentOrganization: { "@id": "#org" },
      telephone: "+380800339797",
      address: addr("проспект Степана Бандери, 30"),
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: weekdays, opens: "09:00", closes: "19:00" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "09:00", closes: "14:00" },
      ],
    },
    {
      "@type": "AutoPartsStore",
      name: "DsvAvto, Велика Кільцева дорога, 4г",
      parentOrganization: { "@id": "#org" },
      telephone: "+380800339797",
      address: { ...addr("Велика Кільцева дорога, 4г"), postalCode: "08130" },
      openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: weekdays, opens: "09:00", closes: "19:00" }],
    },
    {
      "@type": "AutoPartsStore",
      name: "DsvAvto, пункт видачі на вул. В'ячеслава Чорновола, 41",
      parentOrganization: { "@id": "#org" },
      telephone: "+380800339797",
      address: addr("вулиця В'ячеслава Чорновола, 41"),
      openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: weekdays, opens: "10:00", closes: "19:30" }],
    },
    {
      "@type": "AutoRepair",
      name: "СТО DsvAvto",
      parentOrganization: { "@id": "#org" },
      telephone: ["+380958307748", "+380930904445"],
      address: addr("проспект Степана Бандери, 30"),
    },
  ],
};
---
<Base lang="uk" title={title} description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />
  <Hero />
  <Catalog />
  <Sto />
  <Terms />
  <Stores />
  <Footer slot="footer" />
  <Callbar slot="footer" />
</Base>

<script src="../scripts/ui.ts"></script>
